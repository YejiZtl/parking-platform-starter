RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/Streaming/Channels/101

MODEL_PATH=releases/parking_vehicle_black_verified_v3/weights/best.pt
VEHICLE_CLASS_IDS=0
CONF=0.12
IOU=0.35
IMGSZ=1920
MAX_DET=500
DEVICE=0

PARKING_JSON=bounding_boxes.json
PARKING_ROI=parking_roi.json
CALIBRATION_FILE=parking_calibration.json
SLOT_OVERLAP_THRESHOLD=0.30
ONE_VEHICLE_ONE_SPACE=true
SHOW_UNCERTAIN_SLOTS=true
OCCUPIED_CONFIRMATIONS=1
EMPTY_CONFIRMATIONS=2

DETECT_INTERVAL=5
RECONNECT_DELAY=2
OUTPUT_VIDEO=logs/parking_result.mp4
SAVE_JSONL=logs/parking_events.jsonl
LOG_FILE=logs/parking_runtime.log
HEALTH_FILE=logs/parking_health.json
JSONL_MAX_BYTES=52428800
JSONL_BACKUPS=10
LOG_MAX_BYTES=10485760
LOG_BACKUPS=5

# Optional FFmpeg publisher used by run_parking_rtsp.py. MediaMTX remains an
# external service and must already listen on the configured RTSP endpoint.
OUTPUT_STREAM_URL=rtsp://127.0.0.1:8554/parking
OUTPUT_STREAM_FPS=0
DETECT_EVERY_N_FRAMES=5
STREAM_ENCODER=h264_nvenc
STREAM_BITRATE=4M
STATUS_JSON=parking-web/data/status.json
STREAM_PUBLISH=true
